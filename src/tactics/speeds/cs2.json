  "sources": [
    {
      "id": "cs2-vdata",
      "title": "Counter-Strike 2 weapon definitions (scripts/weapons.vdata, m_flMaxSpeed), as tracked by SteamDB's GameTracking-CS2",
      "url": "https://github.com/SteamDatabase/GameTracking-CS2/blob/master/game/csgo/pak01_dir/scripts/weapons.vdata",
      "accessed": "2026-11-08",
      "note": "Valve's own item data from the game files; m_flMaxSpeed is [normal, scoped/alternate] in units per second."
    },
    {
      "id": "csdb",
      "title": "CSDB weapon pages (stats extracted from CS2 game data)",
      "url": "https://csdb.gg/weapons/",
      "accessed": "2026-11-08",
      "note": "Cross-check; agrees with the weapon definitions for every weapon except the Zeus."
    },
    {
      "id": "cs-movement",
      "title": "Counter-Strike Wiki: Movement Mechanics",
      "url": "https://counterstrikewiki.com/Movement_Mechanics",
      "accessed": "2026-11-08",
      "note": "Knife 250 u/s, AWP 200 (100 scoped)."
    }
  ],
  "classes": {
    "infantry": {
      "modes": {"crawl": null, "crouch": 85, "walk": 130, "run": 250, "sprint": null},
      "source": "cs2-vdata",
      "approx": false,
      "note": "Knife (fastest, 250 u/s). run = m_flMaxSpeed from the weapon definition; walk = run x 0.52 (shift-walk), crouch = run x 0.34. The two modifiers are not in any published Valve file; they are the long-standing CS:GO values and were confirmed in CS2 demo telemetry (speed peaks at 0.52 and 0.34 of the run speed for every weapon). No sprint, no prone."
    }
  },

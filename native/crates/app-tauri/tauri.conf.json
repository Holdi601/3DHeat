{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "3DHeat",
  "mainBinaryName": "3dheat-app",
  "version": "../../../package.json",
  "identifier": "io.github.holdi601.heat3d",
  "build": {
    "frontendDist": "../../../dist",
    "devUrl": "http://127.0.0.1:5273",
    "beforeDevCommand": {
      "script": "npm run dev -- --port 5273 --strictPort --host 127.0.0.1",
      "cwd": "../../.."
    },
    "beforeBuildCommand": {
      "script": "npm run build",
      "cwd": "../../.."
    }
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "appimage",
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": false,
    "category": "Utility",
    "shortDescription": "Realtime 3D telemetry heatmap viewer",
    "license": "MIT",
    "resources": {
      "../../../dist/": "web/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      },
      "wix": {
        "bannerPath": "installer/wix-banner.bmp",
        "dialogImagePath": "installer/wix-dialog.bmp",
        "fragmentPaths": [
          "installer/requirements.wxs"
        ],
        "componentGroupRefs": [
          "HeatRequirements"
        ]
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1"
        ],
        "recommends": [
          "mesa-vulkan-drivers"
        ],
        "files": {
          "/usr/share/applications/3dheat-library.desktop": "linux/3dheat-library.desktop"
        }
      },
      "rpm": {
        "depends": [
          "vulkan-loader"
        ],
        "recommends": [
          "mesa-vulkan-drivers"
        ]
      },
      "appimage": {
        "files": {
          "/usr/lib/libvulkan.so.1": "/usr/lib/x86_64-linux-gnu/libvulkan.so.1"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyQzdBOTY0RkU1RUY4NzUKUldSMStGNytaS25ITW93SUQ3L2hyWWlaYnd6aFpWVDZ6aCtWdU91WVY2MHA1QTlsWXBla2g0MXgK",
      "endpoints": [
        "https://github.com/Holdi601/3DHeat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
